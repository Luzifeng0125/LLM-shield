* text=auto
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.yaml text eol=lf
*.js text eol=lf
*.cjs text eol=lf
*.mjs text eol=lf
*.html text eol=lf
*.css text eol=lf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.docx binary
*.pptx binary
*.pdf binary
*.png binary
*.joblib binary
*.model binary
*.bin binary

# 模型产物按原始字节存储：不做换行归一化，避免校验哈希漂移。
app/models/gliner_v3/tokenizer.json binary
app/models/gliner_v3/spm.model binary

# Frozen evidence must retain the bytes used to compute its recorded hashes.
app/models/*.json -text
app/eval/releases/** -text
research/datasets/legacy/** -text

# Preserve the archived PowerShell CRLF bytes when checking edits for whitespace.
research/datasets/legacy/**/scripts/render_manual.ps1 whitespace=trailing-space,space-before-tab,cr-at-eol
