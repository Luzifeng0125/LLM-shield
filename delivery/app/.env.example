# Copy to .env and fill the key locally. Credentials are never committed.
LLM_MODE=real
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=
LLM_TIMEOUT=60
SHIELD_HOST=127.0.0.1
SHIELD_PORT=8787
SHIELD_MODEL_DIR=models
SHIELD_USE_GLINER=true
SHIELD_MAX_PARALLEL_ANALYSES=2
# Optional offline action experiments; empty uses models/necessity_action.joblib.
SHIELD_ACTION_MODEL_PATH=
