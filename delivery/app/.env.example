# 交付包默认离线；真实联调改为 real 并仅在本机填写密钥。
LLM_MODE=mock
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://www.ccsub.net/api/v1
LLM_MODEL=gpt-5.4
LLM_API_KEY=
LLM_TIMEOUT=60
SHIELD_USE_CAMPUS_NER=false
# GLiNER v3 语义实体识别（A 层）。权重约 1.1 GB，不在仓库内。
# 模型目录必须是纯 ASCII 路径：sentencepiece 的 C++ 后端打不开含中文的路径。
SHIELD_USE_GLINER=false
SHIELD_GLINER_MODEL_DIR=D:/project/models/gliner_v3
# 人工 gold NER 候选产物根目录（含 artifact_manifest.json）；留空保持原识别链。
# 与上面的 GLiNER 是两条独立链路：本项非空即启用，可同时开启。
SHIELD_REVIEWED_NER_MODEL_DIR=
SHIELD_REVIEWED_NER_DEVICE=cpu
SHIELD_REVIEWED_NER_DECODING=greedy
# 本机生成的动作候选权重；留空使用 models/necessity_action.joblib。
SHIELD_ACTION_MODEL_PATH=
