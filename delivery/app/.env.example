# 交付包默认离线；真实联调改为 real 并仅在本机填写密钥。
LLM_MODE=mock
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://www.ccsub.net/api/v1
LLM_MODEL=gpt-5.4
LLM_API_KEY=
LLM_TIMEOUT=60

# ---- 模型目录（全项目唯一一处）----
# 必须是**纯 ASCII 路径**：sentencepiece 的 C++ 后端打不开含中文的路径，
# 而本项目目录名是「隐盾」。因此所有本地模型都放这里，项目内不再有 models/ 权重。
#   <SHIELD_MODEL_DIR>/
#     ├── necessity_action.joblib   决策模型（m4，总是加载，约 1MB）
#     ├── gliner_v3/                识别模型（m2，可选，约 1.1GB）
#     ├── gliner_multi_v21/         重训用基座
#     └── gliner_multi/             重训用基座
SHIELD_MODEL_DIR=D:/project/models

# ---- 识别模型（可选）----
# GLiNER 语义识别负责：人名 / 机构 / 地点 / 宿舍 / 敏感属性。
# 格式类（电话/邮箱/证件/银行卡/密钥/微信/预算/成绩）由**带校验位的正则底座**权威判定。
# 实测这种分工比让模型覆盖 13 类精度更高：独立集 F1 0.9068 vs 0.8443。
# 权重约 1.1GB，不随仓库分发（见 docs/评测报告-独立手写集field_v1.md）。
SHIELD_USE_GLINER=true
# 只有想单独指定 GLiNER 目录时才需要设（默认取 <SHIELD_MODEL_DIR>/gliner_v3）
# SHIELD_GLINER_MODEL_DIR=
