# Copy to .env and fill the key locally. Credentials are never committed.
LLM_MODE=real
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=
LLM_TIMEOUT=60

# 可选。启用后，127.0.0.1 上的 OPA 必须明确许可外发操作。
SHIELD_EGRESS_POLICY=off
SHIELD_OPA_PORT=8181

# 本地项目接口。留空关闭，启用前生成独立的随机管理员凭证。
SHIELD_WORKFLOW_ADMIN_TOKEN=
SHIELD_HOST=127.0.0.1
SHIELD_PORT=8787
SHIELD_MODEL_DIR=models
SHIELD_USE_GLINER=true
SHIELD_MAX_PARALLEL_ANALYSES=2
# Optional offline action experiments; empty uses models/necessity_action.joblib.
SHIELD_ACTION_MODEL_PATH=

# Optional integration profile (relative paths are resolved from delivery/app).
# SHIELD_INTEGRATIONS_CONFIG=config/integrations.yaml
# SHIELD_LAKERA_API_KEY=
# SHIELD_DIFY_CAMPUS_TOKEN=
# SHIELD_DELIVERY_TOKEN=
# Native gateway uses model_gateway in the integration profile.
# LLM_PROVIDER=shield
# SHIELD_MODEL_ROUTE=primary
