# Only the maintained project and its supporting material belong in this repo.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/启动隐盾.cmd
!/启动官方模型测试.cmd
!/app/
!/research/
!/docs/
!/CHANGELOG.md
!/.github/
!/tools/
!/00_文件导航.html
!/打开文件导航.cmd
!/打开人工复核.cmd

# Local migrated reports and diagnostics are never repository sources.
/local/

# GLiNER 识别模型的配置与分词器随仓库分发；1.1 GB 权重本体由
# app/.gitignore 的 *.bin 规则排除，哈希见 models/ACTIVE_MODELS.json。

# Local credentials, environments, uploaded materials and generated traces.
**/.env
**/.env.*
!**/.env.example
**/*.env.local
**/.venv/
**/venv/
**/node_modules/
**/runtime/
/app/models/reviewed_ner/
**/__pycache__/
**/.pytest_cache/
**/pytest-cache-files-*/
**/*.py[cod]
**/*.log
**/~$*
**/outputs/
**/data/uploads/*
!**/data/uploads/.gitkeep
**/data/campus_corpus/raw/
**/*.pem
**/*.key
**/*.p12
**/*.pfx

