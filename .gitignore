**/.env
**/.env.*
!**/.env.example
**/*.env.local
**/.venv/
**/venv/
**/node_modules/
**/runtime/
/delivery/app/models/reviewed_ner/
**/__pycache__/
**/.pytest_cache/
**/pytest-cache-files-*/
**/*.py[cod]
**/*.log
**/~$*
**/outputs/
**/data/uploads/*
!**/data/uploads/.gitkeep
**/data/campus_corpus/raw/
**/*.pem
**/*.key
**/*.p12
**/*.pfx

