# Only the maintained project and its supporting material belong in this repo.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/delivery/
!/tools/
!/docs/

# Local credentials, environments, uploaded materials and generated traces.
**/.env
**/.env.*
!**/.env.example
**/*.env.local
**/.venv/
**/venv/
**/node_modules/
**/runtime/
**/__pycache__/
**/.pytest_cache/
**/pytest-cache-files-*/
**/*.py[cod]
**/*.log
**/~$*
**/outputs/
**/data/uploads/*
!**/data/uploads/.gitkeep
**/data/campus_corpus/raw/
**/*.pem
**/*.key
**/*.p12
**/*.pfx

# The active synthetic review package is shared; human reviews stay local.
/delivery/人工复核/*
!/delivery/人工复核/使用说明.md
!/delivery/人工复核/第二台电脑验收.md
!/delivery/人工复核/当前试标.json
!/delivery/人工复核/试标运行/
/delivery/人工复核/试标运行/*
!/delivery/人工复核/试标运行/a08ca7f5ced1/
/delivery/人工复核/试标运行/a08ca7f5ced1/*
!/delivery/人工复核/试标运行/a08ca7f5ced1/evidence.json
!/delivery/人工复核/试标运行/a08ca7f5ced1/独立复核.html
/delivery/交付文件清单.json

# Rendered intermediate files can be regenerated from the retained scripts.
/tools/submission/docx_qa/
/tools/submission/slides_qa/
/tools/submission/draft.pptx*
/tools/qa/automated_review_ui_only.json
